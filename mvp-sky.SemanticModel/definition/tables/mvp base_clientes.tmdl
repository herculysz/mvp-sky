table 'mvp base_clientes'
	lineageTag: 0477a203-387f-4531-a032-2d44fa351b32

	measure ContagemClientes =
			
			CALCULATE(
			    COUNTROWS('mvp base_clientes'),
			    USERELATIONSHIP(
			        'mvp base_clientes'[data_venda],
			        'dim_calendario'[Data]
			    )
			    ,
			    NOT(ISBLANK('mvp base_clientes'[data_venda])
			))
		formatString: #,0
		lineageTag: 6d6d7974-35f0-481b-a86e-9553c6251185

	measure ContagemClientesCancelados =
			
			CALCULATE(
			    COUNTROWS('mvp base_clientes'),
			    USERELATIONSHIP(
			        'mvp base_clientes'[data_cancelamento],
			        'dim_calendario'[Data]
			    ),
			    NOT ISBLANK('mvp base_clientes'[data_cancelamento])
			)
		formatString: 0
		lineageTag: 75d6995b-9e60-4379-aeba-a114392205b8

	measure ContagemClientesAtivados =
			
			CALCULATE(
			    COUNTROWS('mvp base_clientes'),
			    USERELATIONSHIP(
			        'mvp base_clientes'[data_ativacao],
			        'dim_calendario'[Data]
			    ),
			    NOT ISBLANK('mvp base_clientes'[data_ativacao])
			)
		formatString: 0
		lineageTag: 61e11185-e9aa-4358-a3ec-223a92f403b4

	measure ContagemClientesPendentes =
			
			CALCULATE(
			    COUNTROWS('mvp base_clientes'),
			    USERELATIONSHIP(
			        'mvp base_clientes'[data_venda],
			        'dim_calendario'[Data]
			    ),
			    NOT ISBLANK('mvp base_clientes'[data_venda]),
			    'mvp base_clientes'[churn] = 0,
			    'mvp base_clientes'[ativacao] = 0,
			    'mvp base_clientes'[estagio] IN {"PRE-CONTRATO", "EM APROVAÇÃO"}
			)
		formatString: 0
		lineageTag: c66fb3bf-ee10-4465-a60b-1cf301f96e26

