	column evento_macro =
			
			
			IF(
			    CONTAINSSTRING('mvp base_clientes'[evento], "INADIMPLENTE") || CONTAINSSTRING('mvp base_clientes'[evento], "INADIMPLÊNCIA"),
			    "INVOLUNTÁRIO",
			    "VOLUNTÁRIO"
			)
		lineageTag: 11ae7541-031c-4c59-bc2e-7787bdc31808
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'mvp base_clientes' = m
		mode: import
		source =
				let
				    Fonte =
				        PostgreSQL.Database(host, database),
				
				    mvp_base_clientes =
				        Fonte{
				            [
				                Schema = "mvp",
				                Item = "base_clientes"
				            ]
				        }[Data],
				
				    // Mantém somente os clientes de vendedores credenciados SKY
				    #"Linhas Filtradas" =
				        Table.SelectRows(
				            mvp_base_clientes,
				            each [credenciado_sky] = 1
				        ),
				
				    // Remove colunas que não serão utilizadas no relatório
				    // A coluna "usuario" foi mantida como nome do vendedor
				    #"Colunas Removidas" =
				        Table.RemoveColumns(
				            #"Linhas Filtradas",
				            {
				                "id_cliente",
				                "concentrador",
				                "olt",
				                "cidade_olt",
				                "uf_olt",
				                "port_olt",
				                "slot_olt",
				                "tipo",
				                "endereco",
				                "numero",
				                "bairro",
				                "cod_ibge",
				                "descricao",
				                "segmento",
				                "id_vendedor",
				                "cpf_vendedor",
				                "tipo_pessoa",
				                "doc",
				                "dt_servico"
				            },
				            MissingField.Ignore
				        ),
				
				    // Define data_venda como a data principal
				    #"Data da Venda Ajustada" =
				        Table.TransformColumns(
				            #"Colunas Removidas",
				            {
				                {
				                    "data_venda",
				                    each if _ = null then null else Date.From(_),
				                    type date
				                }
				            }
				        ),
				
				    #"Tipos Alterados" =
				        Table.TransformColumnTypes(
				            #"Data da Venda Ajustada",
				            {
				                {"valor_contrato", Currency.Type},
				                {"credenciado_sky", Int64.Type},
				                {"possui_streaming_sky", Int64.Type},
				                {"usuario", type text}
				            }
				        ),
				
				    #"Credenciado SKY Adicionado" =
				        Table.AddColumn(
				            #"Tipos Alterados",
				            "credSky",
				            each
				                if [credenciado_sky] = 1 then "SIM"
				                else if [credenciado_sky] = 0 then "NÃO"
				                else "OUTROS",
				            type text
				        ),
				
				    #"Possui Streaming Adicionado" =
				        Table.AddColumn(
				            #"Credenciado SKY Adicionado",
				            "possuiStreaming",
				            each
				                if [possui_streaming_sky] = 1 then "SIM"
				                else if [possui_streaming_sky] = 0 then "NÃO"
				                else "OUTROS",
				            type text
				        )
				in
				    #"Possui Streaming Adicionado"

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

